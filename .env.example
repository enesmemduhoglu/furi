# Bu dosya SADECE degisken ADLARINI tasir — deger yazma, commit edilir.
# Gercek degerler repo kokundeki .env icinde durur; o dosya gitignored.
# Kurulum adimlari: .claude/skills/insta-yayinla/KURULUM.md

# --------------------------------------------------------------- gorsel uretimi
# insta-ingilizce skill'i icin (WORKFLOW.md). Yayin akisi bunlari kullanmaz.
GEMINI_API_KEY=
FAL_KEY=

# ------------------------------------------------------- content-approval-saas
# Yayin akisinin calismasi icin gereken uc degisken. Zamanlanmis bulut
# calismasinda da tanimli olmalari gerekir.
#
# Bu ucu ayrica Instagram token'ini cekmeye de yariyor:
#   GET <FURI_SAAS_URL>/api/clients/<FURI_CLIENT_ID>/instagram-token
#   Authorization: Bearer <FURI_API_KEY>
FURI_SAAS_URL=
FURI_CLIENT_ID=
FURI_API_KEY=

# ------------------------------------------------------------------- Instagram
# BU REPO INSTAGRAM TOKEN'I TUTMAZ — bilerek burada bir degisken yok.
#
# Token'in tek dogruluk kaynagi SaaS'taki Client kaydidir
# (`instagramAccessToken` + `instagramUserId`) ve SaaS'ta gunluk bir cron onu
# bitisine 20 gun kala otomatik yeniliyor. Burada ikinci bir kopya tutulsaydi
# yenileme gecesi sessizce bayatlar, otomasyon aciklamasiz kirilirdi.
#
# Teshis komutlari (ig_yayinla.py --kontrol/--dogrula, ig_token.py --kontrol)
# token'i her calismada yukaridaki uctan ceker.
#
# Eski `IG_ACCESS_TOKEN` / `IG_USER_ID` degiskenleri KALDIRILDI. .env'inde
# duruyorlarsa sil: hicbir yerde okunmuyorlar ama duran bir sir gereksiz risk.

# ------------------------------------------------------------ opsiyonel (yerel)
# Hicbiri zorunlu degil; bos birakilirsa varsayilanlar kullanilir.
# IG_API_HOST=        # varsayilan graph.instagram.com
# IG_API_VERSION=     # varsayilan v23.0
# IG_RAW_BASE=        # varsayilan: git remote + aktif daldan turetilir
# FURI_REPO=          # varsayilan: script konumundan turetilir
